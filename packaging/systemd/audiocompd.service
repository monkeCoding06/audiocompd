[Unit]
Description=audiocompd real-time audio compressor
Requires=pipewire.service
After=pipewire.service wireplumber.service
Wants=wireplumber.service
ConditionPathExists=/etc/audiocompd/audiocompd.xml

[Service]
Type=simple
ExecStart=/usr/bin/audiocompd --config /etc/audiocompd/audiocompd.xml --schema /usr/share/audiocompd/audiocompd.xsd
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
