[Unit]
Description=audiocompd real-time audio compressor
After=sound.target
ConditionPathExists=/etc/audiocompd/audiocompd.xml

[Service]
Type=simple
User=audiocompd
Group=audiocompd
SupplementaryGroups=audio
ExecStart=/usr/bin/audiocompd --config /etc/audiocompd/audiocompd.xml --schema /usr/share/audiocompd/audiocompd.xsd
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target

